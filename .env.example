# ---------------------------------------------------------------------------
# outbound-reply-triage-router - environment variables
# Set these on your n8n instance (NOT in the workflow JSON, NOT in git).
# Reference: docs/CONFIGURATION.md
#
# n8n must let nodes read env vars:  N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Every value below is a placeholder. Never commit real tokens or webhook URLs.
# ---------------------------------------------------------------------------

# --- SAFETY (read this first) ------------------------------------------------
# Keep "true" until you have tested everything. While true: no CRM writes, no sequence changes,
# no Slack posts, no state saved - actions are only logged on the "Dry Run" node.
# Only the exact words false / 0 / no / off turn it off; anything else (including typos) keeps it ON.
SANDBOX_MODE=true

# --- CLASSIFICATION ----------------------------------------------------------
# Replies below this confidence go to the human-review queue instead of triggering an action
CONFIDENCE_THRESHOLD=0.80
# Explicit opt-outs are honored at this lower threshold on purpose (suppressing is the safe direction)
UNSUBSCRIBE_CONFIDENCE_THRESHOLD=0.60
# MDY (US) or DMY - used to read dates like 03/12/2026 in out-of-office replies
DATE_FORMAT_PREFERENCE=MDY
# Longest reply body processed (characters)
MAX_BODY_CHARS=20000
# Your own sending domains (excluded when extracting "referred contacts"), comma separated
OWN_EMAIL_DOMAINS=

# --- OPTIONAL LLM FALLBACK (off by default) ------------------------------------
# Only consulted when rules are below CONFIDENCE_THRESHOLD and there is no explicit opt-out.
# Replies are redacted (emails/URLs/phones removed) and truncated before leaving n8n.
# Check your privacy obligations (GDPR/CCPA) and provider terms before enabling.
ENABLE_LLM_FALLBACK=false
# OpenAI-compatible chat-completions endpoint (required if the flag is true)
LLM_API_URL=
LLM_MODEL=
# The model's confidence is capped at this value
LLM_MAX_CONFIDENCE=0.90

# --- SEQUENCE CONTROL --------------------------------------------------------
# none    = never touch sequences (default)
# apollo  = stop the contact in an Apollo sequence (needs apolloContactId + apolloSequenceId in the payload)
# webhook = POST {action: pause|resume, ...} to SEQUENCE_WEBHOOK_URL (your own tool / automation)
SEQUENCE_PROVIDER=none
# "stop" halts steps and keeps context. "remove" is PERMANENT.
APOLLO_STOP_MODE=stop
SEQUENCE_WEBHOOK_URL=
# Out-of-office: re-enroll this many days after the return date; default pause if no date is found
OOO_REENROLL_DELAY_DAYS=1
OOO_DEFAULT_PAUSE_DAYS=7
ENABLE_LOCAL_RESUME_QUEUE=true

# --- SUPPRESSION (opt-outs) --------------------------------------------------
# POST target for opt-outs in YOUR suppression system / sending tool. HubSpot opt-out is separate (HUBSPOT_ENABLED).
SUPPRESSION_WEBHOOK_URL=

# --- HUBSPOT (optional) ------------------------------------------------------
# true = look up the contact + owner (read), create tasks, and set hs_email_optout on opt-outs (writes, live mode only)
HUBSPOT_ENABLED=false
INTERESTED_TASK_DUE_HOURS=4
NOT_NOW_FOLLOWUP_DAYS=90

# --- SLACK -------------------------------------------------------------------
# Incoming webhook URL (treat as a secret)
SLACK_WEBHOOK_URL=
# JSON map of HubSpot owner ID -> Slack member ID, used to @mention the owner. Example shape only:
# {"123456":"U0XXXXXXX"}
OWNER_SLACK_MAP_JSON=
NOTIFY_ON_UNSUBSCRIBE=false
NOTIFY_ON_NOT_NOW=false
# Hold the sequence while a human reviews a low-confidence reply, and create a review task
PAUSE_ON_REVIEW=true
REVIEW_CREATE_TASK=true
# Include a short (masked) excerpt of the reply in Slack
SLACK_INCLUDE_EXCERPT=true
